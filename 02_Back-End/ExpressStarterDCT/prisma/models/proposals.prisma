model AppointmentChangeProposal {
  id              Int              @id @default(autoincrement())
  appointmentId   Int
  authorParty     AppointmentParty
  recipientParty  AppointmentParty
  authorUserId    Int?
  recipientUserId Int?
  proposedStartAt DateTime         @db.Timestamptz(3)
  proposedEndAt   DateTime         @db.Timestamptz(3)
  status          ProposalStatus   @default(PENDING)
  rejectionReason String?          @db.VarChar(500)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  decidedAt       DateTime?        @db.Timestamptz(3)
  appointment     Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  author          User?            @relation("ProposalAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  recipient       User?            @relation("ProposalRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([appointmentId, createdAt])
}
